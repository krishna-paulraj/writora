# Dashboard app (authoring UI). Runs on port 3001 by default.

# URL of the API server
NEXT_PUBLIC_API_URL=http://localhost:4000

# URL of the public site (used for "view live blog" links and login redirects)
NEXT_PUBLIC_WWW_URL=http://localhost:3000

# Must match JWT_SECRET in apps/api. Used by middleware to verify the auth cookie.
JWT_SECRET=replace-me-with-a-long-random-string
