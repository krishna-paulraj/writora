generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String    @id @default(cuid())
  name                 String
  email                String    @unique
  username             String    @unique
  password             String?
  googleId             String?   @unique
  blogTheme            String    @default("default")
  customDomain         String?
  bio                  String?
  avatarUrl            String?
  twitterHandle        String?
  websiteUrl           String?
  emailVerified        DateTime?
  inboundWebhookSecret String?   @unique
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  blogs              Blog[]
  categories         Category[]
  subscribers        Subscriber[]
  passwordResets     PasswordReset[]
  emailVerifications EmailVerification[]
  webhookEndpoints   WebhookEndpoint[]
  articleJobs        ArticleJob[]
  savedKeywords      SavedKeyword[]
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, slug])
}

model Blog {
  id              String     @id @default(cuid())
  slug            String
  title           String
  description     String
  content         String
  imageUrl        String?
  category        String
  targetKeyword   String?
  readTime        Int        @default(5)
  featured        Boolean    @default(false)
  published       Boolean    @default(false)
  publishedAt     DateTime?
  scheduledAt     DateTime?
  newsletterSent  Boolean    @default(false)
  authorId        String
  author          User       @relation(fields: [authorId], references: [id])
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  views           BlogView[]
  articleJob      ArticleJob?

  @@unique([authorId, slug])
  @@index([scheduledAt])
}

model BlogView {
  id        String   @id @default(cuid())
  blogId    String
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([blogId])
  @@index([createdAt])
  @@index([blogId, createdAt])
}

model Subscriber {
  id               String    @id @default(cuid())
  email            String
  authorId         String
  author           User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  confirmToken     String    @unique
  unsubscribeToken String    @unique
  confirmedAt      DateTime?
  createdAt        DateTime  @default(now())

  @@unique([authorId, email])
  @@index([authorId, confirmedAt])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model WebhookEndpoint {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  url            String
  description    String?
  secret         String
  enabled        Boolean   @default(true)
  lastDeliveryAt DateTime?
  lastStatus     Int?
  lastError      String?
  createdAt      DateTime  @default(now())

  @@index([userId])
}

model ArticleJob {
  id            String    @id @default(cuid())
  status        String    @default("pending") // pending | running | done | failed
  topic         String
  targetKeyword String?
  tone          String    @default("professional")
  length        String    @default("medium") // short | medium | long
  audience      String?
  category      String?
  keywordData   Json?
  contentPlanId String?
  source        String    @default("manual") // manual | autopilot
  outline       Json?
  progress      Int       @default(0)
  blogId        String?   @unique
  blog          Blog?     @relation(fields: [blogId], references: [id], onDelete: SetNull)
  error         String?
  authorId      String
  author        User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([authorId, status])
  @@index([status])
}

model SavedKeyword {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyword      String
  searchVolume Int?
  difficulty   Int?
  competition  Float?
  cpc          Float?
  seed         String?
  createdAt    DateTime @default(now())

  @@unique([userId, keyword])
  @@index([userId])
}
