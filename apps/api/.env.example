# --- Runtime ---
NODE_ENV=development
PORT=4000

# --- Database ---
# Postgres connection string. For local dev: postgresql://user:pass@localhost:5432/writora
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/writora

# --- Auth ---
# Long random string — generate with: openssl rand -base64 48
# MUST match JWT_SECRET in apps/app and apps/www (their middleware verifies the cookie)
JWT_SECRET=replace-me-with-a-long-random-string

# Cookie domain for the auth token. Leave empty for local dev (host-only cookie).
# In production, set to your apex with a leading dot so the cookie is shared
# across subdomains — e.g. ".yourdomain.com" lets api/app/www all read it.
COOKIE_DOMAIN=".yourdomain.com"

# Where to redirect after Google OAuth completes. Defaults to localhost:3001 in
# dev or https://app.writora.com in production. Set to your dashboard URL.
APP_URL=

# Comma-separated allowlist of origins that may call the API with credentials.
# Defaults to localhost:3000,localhost:3001 if unset.
# Production example: https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=

# --- Google OAuth (optional, only needed for "Sign in with Google") ---
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_SECRET_ID=
GOOGLE_REDIRECT_URL=http://localhost:4000/auth/google/callback

# --- Email (Resend) ---
# Get an API key from https://resend.com/api-keys
# If unset, emails are logged to stdout instead of sent.
RESEND_API_KEY=
# Verified sender in your Resend dashboard. Use onboarding@resend.dev in dev.
EMAIL_FROM="Writora <onboarding@resend.dev>"
EMAIL_REPLY_TO=

# Where the public site (www) is reachable. Used to build email links.
SITE_URL=http://localhost:3000

# Where THIS api is reachable from the public internet. Used to render the
# inbound webhook URL in the dashboard. Defaults to http://localhost:4000.
PUBLIC_API_URL=http://localhost:4000

# --- Redis (optional) ---
# If set, the API caches hot read paths (public blog reads, sitemap, analytics)
# and deduplicates blog views per IP for 24h. If unset, cache calls are no-ops.
# Local dev: docker run -d -p 6379:6379 redis:7-alpine
REDIS_URL=

# --- RabbitMQ (optional) ---
# If set, newsletter blasts are queued durably (survive crashes / restarts).
# If unset, blasts run inline in the API process (lossy on crash, fine for dev).
# Local dev: docker run -d -p 5672:5672 -p 15672:15672 rabbitmq:3-management
RABBITMQ_URL=

# --- Object storage (optional — falls back to local disk if unset) ---
# Works with any S3-compatible service: AWS S3, Cloudflare R2, Backblaze B2,
# DigitalOcean Spaces, MinIO. Set S3_BUCKET to enable.
S3_BUCKET=
# AWS: e.g. us-east-1. R2: auto. MinIO: anything.
S3_REGION=auto
# Leave empty for AWS S3. Required for R2/B2/Spaces/MinIO.
#   R2:      https://<accountid>.r2.cloudflarestorage.com
#   B2:      https://s3.<region>.backblazeb2.com
#   Spaces:  https://<region>.digitaloceanspaces.com
#   MinIO:   http://localhost:9000
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public URL prefix that users see. Should NOT include trailing slash.
#   AWS public bucket:  https://<bucket>.s3.<region>.amazonaws.com
#   R2 with custom dom: https://cdn.yourdomain.com
#   Cloudfront/CDN:     https://d1234.cloudfront.net
S3_PUBLIC_URL=
# Set to "true" for MinIO; leave empty for AWS/R2/B2/Spaces with virtual-hosted style.
S3_FORCE_PATH_STYLE=
# Optional ACL header for buckets that respect ACLs (AWS). Leave empty for R2.
#   Common value: public-read
S3_ACL=

# --- AI (optional) ---
# If set, in-editor AI actions (improve / fix / shorten / continue / suggest
# titles + description) are enabled. If unset, AI endpoints return 503.
OPENAI_API_KEY=
# Defaults to gpt-4o-mini (cheap + fast). gpt-4o for higher quality.
OPENAI_MODEL=gpt-4o-mini

# --- Image generation (Recraft.ai, optional) ---
# If set, AI articles get an auto-generated featured + inline images, and the
# editor's "Generate with AI" image buttons work. If unset, /ai/image returns
# 503 and auto-generation is skipped (articles still generate, just without
# images). Get a key at https://www.recraft.ai/ (API access).
RECRAFT_API_KEY=
# recraftv3 (default) is the latest model; recraftv2 is the older/cheaper one.
RECRAFT_MODEL=recraftv3
# Override only if Recraft changes its API host.
RECRAFT_API_URL=https://external.api.recraft.ai/v1

# --- Keyword research (DataForSEO, optional) ---
# Credentials from https://app.dataforseo.com/api-access (HTTP Basic auth).
# If unset, /keywords/* endpoints return 503. Lookups are cached 24h (they cost
# credits). On-page SEO scoring (/seo/score) works without these.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Default geo/language for keyword ideas. 2840 = United States, "en" = English.
DATAFORSEO_LOCATION_CODE=2840
DATAFORSEO_LANGUAGE_CODE=en
