# Public site (blog reader). Runs on port 3000 by default.

# URL of the API server
NEXT_PUBLIC_API_URL=http://localhost:4000

# URL of this site (used for canonical URLs, OG tags, sitemap, robots.txt)
NEXT_PUBLIC_WWW_URL=http://localhost:3000

# URL of the dashboard app (used by login/signup redirects after auth)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Must match JWT_SECRET in apps/api. Used by middleware to verify the auth cookie.
JWT_SECRET=replace-me-with-a-long-random-string
