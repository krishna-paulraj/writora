# Public site (blog reader). Runs on port 3000 by default.

# URL of the API server
NEXT_PUBLIC_API_URL=http://localhost:4000

# URL of this site (used for canonical URLs, OG tags, sitemap, robots.txt)
NEXT_PUBLIC_WWW_URL=http://localhost:3000

# URL of the dashboard app (used by login/signup redirects after auth)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Must match JWT_SECRET in apps/api. Used by middleware to verify the auth cookie.
JWT_SECRET=replace-me-with-a-long-random-string

# --- Contact form (server-side, used by actions/server-action.ts) ---
# Resend API key used to deliver contact-form messages. When unset, the form
# reports "not configured" instead of pretending to send.
RESEND_API_KEY=
# Inbox that receives contact-form messages. Required for delivery.
CONTACT_TO_EMAIL=
# From address for contact-form mail. Optional; defaults to
# "Writora <onboarding@resend.dev>".
EMAIL_FROM=
