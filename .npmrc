public-hoist-pattern[]=*@radix-ui/*

# Flat, npm-style node_modules. NestJS emits a runtime require("express") for
# decorated @Req()/@Res() params (emitDecoratorMetadata), but express is only a
# transitive dep — pnpm's default isolated layout doesn't expose it to app code,
# so `node dist/src/main` fails with "Cannot find module 'express'" in prod.
# Hoisting makes transitive deps resolvable (matches npm/yarn behavior).
node-linker=hoisted
