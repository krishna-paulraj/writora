{
  "name": "writora",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "check": "pnpm format:check && pnpm lint && pnpm check-types",
    "clean": "turbo run clean && rm -rf .turbo node_modules/.cache"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.8.17",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20.9"
  },
  "packageManager": "pnpm@10.28.1"
}
